rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== Helper Functions ====================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isVendor(vendorId) {
      return isAuthenticated() && request.auth.uid == vendorId;
    }
    
    function isStoreOwner(storeId) {
      return isAuthenticated() && request.auth.uid == storeId;
    }
    
    // ==================== Users Collection ====================
    
    match /users/{userId} {
      // Users can read and update their own profile
      allow read, update: if isOwner(userId) || isAdmin();
      // Anyone authenticated can create a user profile (during registration)
      allow create: if isAuthenticated() && 
                       isOwner(userId) &&
                       // Validate required fields on create
                       request.resource.data.keys().hasAll(['name', 'email']) &&
                       request.resource.data.name is string &&
                       request.resource.data.email is string;
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ==================== Restaurants Collection ====================
    
    match /restaurants/{restaurantId} {
      // Public read access
      allow read: if true;
      // Only admins can create/update/delete restaurants
      allow create, update, delete: if isAdmin();
      // Restaurant owners can update their own restaurant
      allow update: if isVendor(restaurantId);
    }
    
    // ==================== Stores Collection ====================
    
    match /stores/{storeId} {
      // Public read access
      allow read: if true;
      // Only admins can create/update/delete stores
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== Meals Collection ====================
    
    match /meals/{mealId} {
      // Public read access
      allow read: if true;
      // Only authenticated users can create meals
      allow create: if isAuthenticated();
      // Only admins or restaurant owners can update/delete
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.restaurantId != null && 
         isVendor(request.resource.data.restaurantId))
      );
    }
    
    // ==================== Orders Collection ====================
    
    match /orders/{orderId} {
      // Users can create their own orders
      allow create: if isAuthenticated() &&
                       // Validate order data on create
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'items', 'totalAmount', 'status']) &&
                       request.resource.data.totalAmount is number &&
                       request.resource.data.totalAmount > 0 &&
                       request.resource.data.status is string;
      
      // Users can read their own orders
      // Restaurant/store owners can read orders for their business
      // Admins can read all orders
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        (resource.data.restaurantId != null && isVendor(resource.data.restaurantId)) ||
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId)) ||
        isAdmin()
      );
      
      // Users can update their own orders (e.g., cancel)
      // Restaurant/store owners can update orders for their business (status changes)
      // Admins can update any order
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        (resource.data.restaurantId != null && isVendor(resource.data.restaurantId)) ||
        (resource.data.storeId != null && isStoreOwner(resource.data.storeId)) ||
        isAdmin()
      );
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }
    
    // ==================== Transactions Collection ====================
    
    match /transactions/{transactionId} {
      // Users can create transactions
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      // Users can only read their own transactions
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Transactions are immutable (no updates/deletes)
      allow update, delete: if false;
    }
    
    // ==================== Notifications Collection ====================
    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
      );
      // System can create notifications (via Cloud Functions)
      // Users can update/delete their own notifications
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
      );
    }
    
    // ==================== Ratings Collection ====================
    
    match /ratings/{ratingId} {
      // Public read access
      allow read: if true;
      // Authenticated users can create ratings
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'rating', 'targetType', 'targetId']) &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5;
      // Users can update/delete their own ratings
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
      );
    }
    
    // ==================== Broadcasts Collection ====================
    
    match /broadcasts/{broadcastId} {
      // Authenticated users can read broadcasts
      allow read: if isAuthenticated();
      // Only admins can create/update/delete broadcasts
      allow write: if isAdmin();
    }
    
    // ==================== Agents Collection ====================
    
    match /agents/{agentId} {
      // Authenticated users can read agent info
      allow read: if isAuthenticated();
      // Only admins can create/update/delete agents
      allow write: if isAdmin();
      // Agents can update their own profile
      allow update: if isOwner(agentId);
    }
    
    // ==================== Payment Orchestration Collections ====================
    
    // Transaction Ledger - Financial records
    match /transaction_ledger/{ledgerId} {
      // Only admins and system (Cloud Functions) can read/write
      // Users cannot directly access transaction ledger
      allow read, write: if isAdmin();
    }
    
    // Pending Payouts - Queue of payouts to process
    match /pending_payouts/{payoutId} {
      // Only admins and system can access
      allow read, write: if isAdmin();
    }
    
    // Batch Payouts - History of batch processing
    match /batch_payouts/{batchId} {
      // Only admins can access
      allow read, write: if isAdmin();
    }
    
    // Failed Payouts - Failed payout records
    match /failed_payouts/{failedId} {
      // Only admins can access
      allow read, write: if isAdmin();
    }
    
    // Idempotency Keys - Prevent duplicate operations
    match /idempotency_keys/{keyId} {
      // Only system (Cloud Functions) can access
      allow read, write: if isAdmin();
    }
    
    // ==================== Default Deny ====================
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
